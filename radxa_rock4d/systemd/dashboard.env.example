# Install as /etc/driver-monitor/dashboard.env; choose the real device paths.
DRIVER_MONITOR_SOURCE=/dev/video0
DRIVER_MONITOR_SERIAL_PORT=/dev/ttyUSB0
DRIVER_MONITOR_PREVIEW_FPS=15
# Choose 2/5/10/15/30 after measuring inference and preview on the board.
# Omit DRIVER_MONITOR_TOKEN to generate/store a code at logs/.dashboard-token.
